# BizStack Perks — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — secrets belong in your host/platform's
# environment configuration (Railway, Docker secrets, etc.), not in git.

# ============================================================================
# Core App
# ============================================================================

# Admin login for /dashboard, /admin, /client (change these before deploying!)
BIZSTACK_ADMIN_USER=admin
BIZSTACK_ADMIN_PASS=change-me-to-a-strong-password

# Signs the session cookie. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_COOKIE_SECRET=replace-with-a-long-random-secret

# Public HTTPS origin of your deployed app, no trailing slash.
# Required for correct Stripe redirect URLs and Twilio callback URLs.
PUBLIC_BASE_URL=https://your-domain.example

# Shared secret for bot/API access to protected endpoints (X-API-Key header)
BOT_API_TOKEN=replace-with-a-long-random-api-token

# Optional override for the SQLite database file location. On Railway, leave
# unset to persist application data on the attached /app/data volume.
DATABASE_PATH=/absolute/path/to/bizstack.db

# Optional custom lead consent disclosure text shown on /apply
LEAD_CONSENT_TEXT=

# ============================================================================
# Stripe
# ============================================================================

STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PRICE_ID=price_...

# Display copy for the homepage pricing card
OFFER_PRICE_DISPLAY=$49 / month

# ============================================================================
# Telephony: Twilio OR SignalWire (Voice + SMS)
# ============================================================================
# Use ONE of the two credential sets below. If SignalWire vars are set,
# they take priority automatically -- you do not need to unset the TWILIO_*
# vars, but you can remove them once SignalWire is confirmed working.

# --- Option A: SignalWire (recommended if you've switched providers) ---
# From your SignalWire dashboard (https://<your-space>.signalwire.com):
SIGNALWIRE_PROJECT_ID=00000000-0000-0000-0000-000000000000
SIGNALWIRE_API_TOKEN=PTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SIGNALWIRE_SPACE_URL=your-space.signalwire.com
SIGNALWIRE_PHONE_NUMBER=+15550000000

# --- Option B: Twilio (used only if SignalWire vars above are not set) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15550000000
# TWILIO_NUMBER is a legacy alias for TWILIO_PHONE_NUMBER; either works.

# See TWILIO_SETUP.md to upgrade from trial and remove the disclaimer.

# ============================================================================
# Voice Bot (optional — falls back to rule-based responses if unset)
# ============================================================================

OPENAI_API_KEY=sk-proj-...

# ============================================================================
# Email (optional — fallback login channel for the customer portal in case
# SMS delivery fails or a customer prefers email; uses standard SMTP so any
# provider works, e.g. Gmail App Passwords, SendGrid, Mailgun, Postmark)
# ============================================================================

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-smtp-password-or-api-key
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_USE_TLS=true

# ============================================================================
# AWS OTP Delivery (Amazon SES for email and Amazon SNS for SMS)
# ============================================================================
# Set AWS_OTP_ENABLED=true to prefer AWS delivery over SMTP and SignalWire.
# The SES sender must be verified in the selected region. If SES or SNS is in
# a sandbox, also verify each destination email address or phone number.
AWS_OTP_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=no-reply@your-domain.example
# Optional. Sender IDs are not supported in every destination country.
AWS_SNS_SENDER_ID=BizStack

# ============================================================================
# Inbound Email — receive replies, lead inquiries, and client messages
#
# Option A: IMAP Polling — poll any email inbox for new messages
#   Works with Gmail, Outlook, custom IMAP servers, etc.
#   Gmail: enable "App Passwords" and use imap.gmail.com
#   Outlook: use outlook.office365.com, port 993
# ============================================================================

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-gmail-app-password
IMAP_FOLDER=INBOX
# How often to poll for new messages (seconds). Default: 60
IMAP_POLL_INTERVAL_SECONDS=60

# Option B: Webhook push (zero polling, instant delivery)
#   Point your email provider's inbound webhook at:
#     POST https://your-domain.example/api/email/inbound
#   Supported providers: SendGrid Inbound Parse, Postmark Inbound, Mailgun Routes
#   Optional shared secret for webhook verification:
INBOUND_EMAIL_WEBHOOK_SECRET=

# ============================================================================
# Bot behavior — autonomous email auto-reply
# ============================================================================

# Set to 'true' to have the bot automatically SEND email replies to inbound
# emails without admin review. Default is 'false' (drafts stored for review).
# Only enable this after testing the reply quality in review mode first.
BOT_AUTO_SEND_EMAIL=false

# ============================================================================
# Bot Agent scheduler (bot_agent.py)
# ============================================================================

# Hours after lead submission before the bot sends a follow-up text (default: 2)
BOT_FOLLOW_UP_HOURS=2

# Maximum follow-up texts the bot will send per lead (default: 2)
BOT_MAX_FOLLOW_UPS=2

# ============================================================================
# Lead Discovery (optional — features disable gracefully if unset)
# ============================================================================

# Google Places API key, used for lead discovery by location + category
GOOGLE_PLACES_API_KEY=

# US Census Bureau API key, used for geographic opportunity analysis
# Free signup, no cost: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Federal Reserve Bank of St. Louis (FRED) API key, used for public banking
# and economic indicators (mortgage rates, prime rate, business loan trends,
# unemployment, etc.) in the targeting write-up generator. Free signup, no
# cost, official government data: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NewsAPI key, used to scan public news for business expansion/loan-seeking
# signals (press releases, funding announcements, new locations). Free tier
# available: https://newsapi.org/register
NEWSAPI_KEY=

# ============================================================================
# Outreach Email (CAN-SPAM compliance)
# ============================================================================

# Company name shown in generated outreach emails
SENDER_COMPANY_NAME=BizStack Perks

# REQUIRED by the CAN-SPAM Act: every commercial email must include a real
# physical mailing address. The outreach generator will refuse to run
# without this set.
SENDER_PHYSICAL_ADDRESS=

# ============================================================================
# Affiliates
# ============================================================================

# Static partner list shown on /affiliates (JSON array of {name, url, description})
AFFILIATE_PARTNERS_JSON=[]

# Partner API configs used by the automated affiliate lead network
# (JSON array of {name, api_url, api_key})
AFFILIATE_PARTNERS_CONFIG=[]
