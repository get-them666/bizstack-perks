# Ignore local database states
bizstack.db
bizstack.db-journal
data/*.db
data/*.db-journal
*.db

# Ignore background automated data storage vaults
storage_vault/
backups/

# Ignore local python virtual environments and cache layers
venv/
.venv/
__pycache__/
*.pyc
node_modules/

# Ignore secrets and environment files
.env
.env.local
.env.production

# Ignore logs
*.log
api_server.log

# Ignore editor/OS state files
untitled text*
.DS_Store
.icloud

# Ignore the data/ directory by default (runtime/local storage)...
data/*
# ...EXCEPT the curated affiliate links file, which is source-controlled
# so it deploys with the app and is checked by verify_links.py in CI.
!data/perks.json

# Google Drive sync artifacts (if the repo is ever inside a synced folder)
.tmp.driveupload/
.tmp.drivedownload/
