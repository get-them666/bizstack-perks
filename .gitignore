# Ignore local database states
bizstack.db
bizstack.db-journal
data/*.db
data/*.db-journal
*.db

# Ignore background automated data storage vaults
storage_vault/
backups/

# Ignore local python virtual environments and cache layers
venv/
.venv/
__pycache__/
*.pyc
node_modules/

# Ignore secrets and environment files
.env
.env.local
.env.production

# Ignore logs
*.log
api_server.log

# Ignore editor/OS state files
untitled text*
.DS_Store
.icloud

# Ignore the data/ directory (runtime/local storage). Note: this path is
# also volume-mounted on Railway in production, so nothing meant to ship
# with the app (like perks.json, which lives at the repo root instead)
# should ever be placed here.
data/*

# Google Drive sync artifacts (if the repo is ever inside a synced folder)
.tmp.driveupload/
.tmp.drivedownload/
